<Window x:Class="DR2AutosaveSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danganronpa 2: Goodbye Despair - Autosave Mod Setup Tool"
        Width="1120" Height="700" WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#F3ECDD"
        FontFamily="Segoe UI" FontSize="14" Foreground="#111114"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        BorderBrush="#111114" BorderThickness="1">
    <Window.Resources>
        <SolidColorBrush x:Key="Pink" Color="#F0146E"/>
        <SolidColorBrush x:Key="Yellow" Color="#F6E71D"/>
        <SolidColorBrush x:Key="Cream" Color="#F3ECDD"/>
        <SolidColorBrush x:Key="Ink" Color="#111114"/>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

        <DrawingBrush x:Key="Dots" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M0,0 H8 V8 H0 Z"/>
                    <GeometryDrawing Brush="#40111114"><GeometryDrawing.Geometry><EllipseGeometry Center="4,4" RadiusX="1.7" RadiusY="1.7"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="DotsDense" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Viewbox="0,0,6,6" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M0,0 H6 V6 H0 Z"/>
                    <GeometryDrawing Brush="#99333338"><GeometryDrawing.Geometry><EllipseGeometry Center="3,3" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Viewbox="0,0,2,2" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F3ECDD" Geometry="M0,0 H2 V2 H0 Z"/>
                    <GeometryDrawing Brush="#111114" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Geometry x:Key="Palm">M60,130 C58,95 62,70 72,46 L77,48 C68,72 66,96 70,130 Z M74,46 C58,30 36,30 18,44 C36,38 54,42 72,50 Z M74,46 C62,22 40,12 20,14 C40,22 58,32 72,48 Z M74,46 C78,22 96,8 118,8 C102,18 88,30 78,48 Z M74,46 C92,30 116,30 134,46 C114,40 96,42 78,50 Z M74,46 C88,50 102,64 106,84 C96,68 86,58 72,52 Z M74,46 C60,52 48,66 44,86 C54,70 62,60 76,52 Z</Geometry>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="56" Background="Transparent">
                            <Path x:Name="Bg" Data="M0,0 H186 L172,52 H0 Z" Fill="#1D1D22"/>
                            <StackPanel Orientation="Horizontal" Margin="22,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="19" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Fill" Value="#34343C"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Fill" Value="#F0146E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavExit" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="56" Background="Transparent">
                            <Path x:Name="Bg" Data="M0,0 H186 L172,52 H0 Z" Fill="#1D1D22"/>
                            <StackPanel Orientation="Horizontal" Margin="22,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="19" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Fill" Value="#34343C"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#F0146E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="#111114" CornerRadius="2"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#F0146E"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Width="290" Height="64" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Path Data="M24,6 H290 V64 H0 Z" Fill="#F0146E"/>
                            <Path x:Name="Face" Data="M22,0 H284 V58 H0 Z" Fill="#F3ECDD" Stroke="#111114" StrokeThickness="2"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,6">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <TextBlock Text="»" FontFamily="Impact" FontSize="36" Foreground="#F0146E" Margin="12,-6,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Fill" Value="#F6E71D"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinkCheck" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="34" Height="34" Background="White" BorderBrush="#111114" BorderThickness="2" CornerRadius="3">
                            <Path x:Name="Tick" Data="M7,16 L13,23 L26,8" Stroke="White" StrokeThickness="4" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F0146E"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="B" Padding="12,8" Background="White"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F0146E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinkCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="White" BorderBrush="#111114" BorderThickness="2" CornerRadius="3">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,34,0" VerticalAlignment="Center"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#111114" BorderThickness="2" MinWidth="{TemplateBinding ActualWidth}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlideArrow" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Polygon x:Name="Arrow" Points="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#111114" Stroke="#FBF1E6" StrokeThickness="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Arrow" Property="Fill" Value="#F0146E"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Arrow" Property="Fill" Value="#F0146E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlideDot" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Slides"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="30" Height="36" Background="Transparent">
                            <Ellipse x:Name="Dot" Width="14" Height="14" Fill="#77777F"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#F0146E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="18,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="128"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="#111114" MouseLeftButtonDown="OnTitleDrag">
            <TextBlock Text="Danganronpa 2: Goodbye Despair - Autosave Mod Setup Tool" Foreground="White" VerticalAlignment="Center" Margin="14,0" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize"/>
                <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="OnExit" AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>

        <!-- Banner -->
        <Canvas Grid.Row="1" ClipToBounds="True" Background="#F3ECDD">
            <Path Data="M380,0 H1120 V128 H300 Z" Fill="{StaticResource Yellow}"/>
            <Path Data="M380,0 H1120 V128 H300 Z" Fill="{StaticResource Dots}"/>
            <Path Data="M0,112 L620,92 L1120,62 V82 L620,112 L0,128 Z" Fill="{StaticResource Pink}"/>
            <Path Data="M560,16 H960 L915,104 H515 Z" Fill="{StaticResource Ink}"/>
            <Path Data="{StaticResource Palm}" Fill="{StaticResource Ink}" Canvas.Left="965" Canvas.Top="-6" Width="150" Height="140" Stretch="Uniform"/>
            <Path Data="{StaticResource Palm}" Fill="{StaticResource Ink}" Canvas.Left="440" Canvas.Top="8" Width="96" Height="96" Stretch="Uniform"/>
            <TextBlock Canvas.Left="26" Canvas.Top="4" Text="DANGANRONPA 2" FontFamily="Impact" FontSize="56" FontStyle="Italic" Foreground="{StaticResource Ink}">
                <TextBlock.Effect><DropShadowEffect Color="#F0146E" ShadowDepth="4" Direction="315" BlurRadius="0" Opacity="1"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock Canvas.Left="32" Canvas.Top="72" Text="Goodbye Despair" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="22" Foreground="{StaticResource Ink}"/>
            <TextBlock Canvas.Left="590" Canvas.Top="20" Text="AUTOSAVE MOD" FontFamily="Impact" FontStyle="Italic" FontSize="38" Foreground="White"/>
            <TextBlock Canvas.Left="572" Canvas.Top="60" Text="SETUP TOOL" FontFamily="Impact" FontStyle="Italic" FontSize="34" Foreground="{StaticResource Pink}"/>
        </Canvas>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Grid Background="#111114" ClipToBounds="True">
                <Rectangle Height="44" VerticalAlignment="Bottom" Fill="{StaticResource Checker}"/>
                <Path Data="{StaticResource Palm}" Fill="#2C2C33" Width="150" Height="150" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,36"/>
                <StackPanel Margin="0,16,0,0">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Tag="&#xE768;" Content="General" IsChecked="True" Checked="OnNav"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" Checked="OnNav"/>
                    <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Advanced" Checked="OnNav"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" Checked="OnNav"/>
                    <Button Style="{StaticResource NavExit}" Content="Exit" Click="OnExit"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="88"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Pages -->
                <Grid x:Name="Pages" Margin="16,14,10,4">
                    <Grid.RenderTransform><TranslateTransform x:Name="PagesShift"/></Grid.RenderTransform>

                    <DockPanel x:Name="PageGeneral">
                        <Border DockPanel.Dock="Top" Background="#111114" CornerRadius="3"><TextBlock Style="{StaticResource PageTitle}" Text="General Setup"/></Border>
                        <StackPanel Margin="8,14,8,0">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE74E;"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="IntervalLabel" Style="{StaticResource Label}" Text="Autosave Interval:" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="IntervalBox" Style="{StaticResource PinkCombo}" AutomationProperties.LabeledBy="{Binding ElementName=IntervalLabel}"/>
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="#55111114" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xEA8F;"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Show Notification when Autosaving:"/>
                                <CheckBox x:Name="NotifyCheck" Grid.Column="2" Style="{StaticResource PinkCheck}" AutomationProperties.Name="Show notification when autosaving"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#55111114" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8F1;"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Keep Backup Saves:"/>
                                <CheckBox x:Name="BackupCheck" Grid.Column="2" Style="{StaticResource PinkCheck}" AutomationProperties.Name="Keep backup saves"/>
                            </Grid>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel x:Name="PageSettings" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="#111114" CornerRadius="3"><TextBlock Style="{StaticResource PageTitle}" Text="Game Settings"/></Border>
                        <StackPanel Margin="8,14,8,0">
                            <TextBlock Style="{StaticResource Label}" Text="Game folder:" Margin="0,0,0,6"/>
                            <Border Background="White" BorderBrush="#111114" BorderThickness="2" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock x:Name="FolderText" TextWrapping="Wrap" FontSize="13"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Button Style="{StaticResource SmallButton}" Content="Browse..." Click="OnBrowse" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource SmallButton}" Content="Detect Again" Click="OnDetect"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Where autosaves go" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Body}" Text="Autosaves rotate through save slots 28, 29 and 30. They appear in the normal Load menu with an [AUTO] tag."/>
                            <TextBlock Style="{StaticResource Body}" Text="Slots holding your own saves are never overwritten."/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel x:Name="PageAdvanced" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="#111114" CornerRadius="3"><TextBlock Style="{StaticResource PageTitle}" Text="Advanced"/></Border>
                        <StackPanel Margin="8,14,8,0">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Game version" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DiagGame" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="DirectX 9" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DiagDx" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Mod" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DiagMod" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Autosave slots"/>
                                <TextBlock x:Name="DiagSlots" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SmallButton}" Content="Open Log" Click="OnOpenLog" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource SmallButton}" Content="Open Backups" Click="OnOpenBackups"/>
                            </StackPanel>
                            <Button x:Name="UninstallButton" Style="{StaticResource SmallButton}" Content="Uninstall Mod" Click="OnUninstall" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="#111114" CornerRadius="3"><TextBlock Style="{StaticResource PageTitle}" Text="About"/></Border>
                        <StackPanel Margin="8,14,8,0">
                            <TextBlock Style="{StaticResource Label}" Text="DR2 Autosave Mod 1.0" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Body}" Text="Saves your game automatically, only at moments when the game itself allows saving."/>
                            <TextBlock Style="{StaticResource Body}" Text="To resume, open Load and pick a slot marked [AUTO]."/>
                            <TextBlock Style="{StaticResource Body}" Text="Requires the Steam version of Danganronpa 2: Goodbye Despair."/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Text="Unofficial fan-made mod, not affiliated with or endorsed by Spike Chunsoft. Characters and sprites belong to their respective owners."/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Character slideshow -->
                <Border Grid.Column="1" Margin="4,14,14,4" Background="#111114" BorderBrush="#111114" BorderThickness="3">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid x:Name="Stage" ClipToBounds="True" Background="#FBF1E6">
                            <Rectangle Fill="{StaticResource Dots}" Opacity="0.55"/>
                            <Rectangle Fill="{StaticResource DotsDense}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.3"/>
                                        <GradientStop Color="#00000000" Offset="0.72"/>
                                        <GradientStop Color="#FF000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Canvas>
                                <Grid Canvas.Left="-62" Canvas.Top="62" Width="190" Height="190" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><RotateTransform x:Name="RingLeft"/></Grid.RenderTransform>
                                    <Ellipse Stroke="#55777780" StrokeThickness="22"/>
                                    <Ellipse Margin="34" Stroke="#40777780" StrokeThickness="5" StrokeDashArray="5,3"/>
                                </Grid>
                                <Grid Canvas.Left="372" Canvas.Top="150" Width="170" Height="170" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><RotateTransform x:Name="RingRight"/></Grid.RenderTransform>
                                    <Ellipse Stroke="#50777780" StrokeThickness="9" StrokeDashArray="9,3"/>
                                    <Ellipse Margin="28" Stroke="#40777780" StrokeThickness="14"/>
                                </Grid>
                                <Path Data="M175,-30 H405 L200,430 H-30 Z" Fill="{StaticResource Pink}">
                                    <Path.RenderTransform><TranslateTransform x:Name="BandShift"/></Path.RenderTransform>
                                </Path>
                            </Canvas>
                            <Grid x:Name="Actor" Margin="26,10,26,-6">
                                <Grid.RenderTransform><TranslateTransform x:Name="ActorBob"/></Grid.RenderTransform>
                            </Grid>
                            <Path Data="M90,-30 H210 L90,430 H-30 Z" Fill="{StaticResource Pink}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <Path.RenderTransform><TranslateTransform x:Name="Wipe" X="-900"/></Path.RenderTransform>
                            </Path>
                            <Button Style="{StaticResource SlideArrow}" Tag="10,32 40,8 40,56" HorizontalAlignment="Left" Click="OnPreviousSlide" AutomationProperties.Name="Previous character"/>
                            <Button Style="{StaticResource SlideArrow}" Tag="10,8 40,32 10,56" HorizontalAlignment="Right" Click="OnNextSlide" AutomationProperties.Name="Next character"/>
                        </Grid>
                        <StackPanel x:Name="SlideDots" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Status -->
                <Border Grid.Row="1" Background="#111114" CornerRadius="3" Margin="16,6,10,14" Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusIcon" Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Status:" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="StatusText" Foreground="#DDDDDD" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="SaveButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource SaveButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,6" Click="OnSave">
                    <TextBlock x:Name="SaveLabel" Text="Save Settings" FontFamily="Impact" FontStyle="Italic" FontSize="30"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
